  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@sparticuz/chromium": "^149.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.10",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.9.1",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.5.0",
    "puppeteer-core": "^25.2.1",
    "resend": "^6.12.3",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
