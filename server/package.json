  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run db:generate && tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:push:schema": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "db:seed-skills": "tsx src/scripts/seed-skill-catalog.ts",
    "db:seed-primary": "tsx src/seed.ts --primary",
    "db:seed-vendors": "tsx src/scripts/seed-vendors.ts",
    "db:seed-demo": "tsx src/scripts/seed-demo-data.ts",
    "db:seed-upcoming-interviews": "tsx src/scripts/seed-upcoming-interviews.ts",
    "db:seed-interview-panels": "tsx src/scripts/seed-interview-panels.ts",
    "db:attach-resumes": "tsx src/scripts/attach-resumes.ts",
    "db:dedupe-users": "tsx src/scripts/dedupe-users.ts",
